<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carcare_background">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActions">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Regresar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/carcare_text_primary" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/agregar_mantenimiento_titulo"
                    android:textColor="@color/carcare_text_primary"
                    android:textStyle="bold"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVehicleContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/service_vehicle_missing"
                android:textColor="@color/carcare_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilType"
                style="@style/Widget.CarCare.LabeledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Servicio: por ejemplo, cambio de aceite">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="textCapSentences"
                    android:textColor="@color/carcare_text_primary"
                    android:textSize="15sp"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStatus"
                style="@style/Widget.CarCare.LabeledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Estado"
                app:helperText="@string/service_status_help"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/carcare_text_secondary">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="none"
                    android:padding="16dp"
                    android:textColor="@color/carcare_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDate"
                style="@style/Widget.CarCare.LabeledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Fecha del servicio (AAAA-MM-DD)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="date"
                    android:textColor="@color/carcare_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvServiceMileage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/carcare_text_primary"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tvServiceMileageHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/carcare_text_secondary"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleServiceMileage"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:textColor="@color/carcare_electric_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMileageHelp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/field_help"
                android:textAllCaps="false"
                android:textColor="@color/carcare_electric_blue" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMileage"
                style="@style/Widget.CarCare.LabeledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Kilometraje del servicio"
                app:helperText="@string/service_mileage_help">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMileage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="number"
                    android:textColor="@color/carcare_text_primary"
                    android:textSize="15sp"
                    android:maxLength="7" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCost"
                style="@style/Widget.CarCare.LabeledInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Costo en MXN"
                app:helperText="@string/service_cost_help">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="numberDecimal"
                    android:textColor="@color/carcare_text_primary"
                    android:textSize="15sp"
                    android:maxLength="12" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleDetails"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/service_details_show"
                android:textAllCaps="false"
                android:textColor="@color/carcare_electric_blue"
                android:gravity="start|center_vertical" />

            <LinearLayout
                android:id="@+id/containerDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWorkshop"
                    style="@style/Widget.CarCare.LabeledInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Taller (opcional)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkshop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="textCapSentences"
                        android:textColor="@color/carcare_text_primary"
                        android:textSize="15sp"
                        android:maxLength="120" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescription"
                    style="@style/Widget.CarCare.LabeledInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Notas (opcional)"
                    app:helperText="@string/service_notes_help">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:textColor="@color/carcare_text_primary"
                        android:textSize="15sp"
                        android:maxLength="1000" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceipt"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/receipt_add"
                android:textAllCaps="false"
                android:textColor="@color/carcare_electric_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/receipt_help"
                android:textColor="@color/carcare_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTogglePlan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/service_plan_show"
                android:textAllCaps="false"
                android:textColor="@color/carcare_electric_blue"
                android:gravity="start|center_vertical" />

            <LinearLayout
                android:id="@+id/containerPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/service_plan_help"
                    android:textColor="@color/carcare_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTargetMode"
                    style="@style/Widget.CarCare.LabeledInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/target_mode_hint"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/carcare_text_secondary">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actTargetMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="none"
                        android:saveEnabled="false"
                        android:padding="16dp"
                        android:textColor="@color/carcare_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/tvTargetHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/carcare_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTargetHelp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/field_help"
                    android:textAllCaps="false"
                    android:textColor="@color/carcare_electric_blue" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNextDate"
                    style="@style/Widget.CarCare.LabeledInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/service_next_date_hint"
                    app:helperText="@string/service_next_date_help">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNextDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="date"
                        android:textColor="@color/carcare_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNextMileage"
                    style="@style/Widget.CarCare.LabeledInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/service_next_mileage_hint"
                    app:helperText="@string/service_next_mileage_help">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNextMileage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="number"
                        android:textColor="@color/carcare_text_primary"
                        android:textSize="15sp"
                        android:maxLength="7" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkCreateReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/service_create_reminder"
                    android:textColor="@color/carcare_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/service_link_help"
                    android:textColor="@color/carcare_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:background="@color/carcare_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveMaintenance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/guardar_mantenimiento"
            android:textAllCaps="false"
            app:backgroundTint="@color/carcare_electric_blue"
            app:cornerRadius="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/cancelar"
                android:textColor="@color/carcare_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteMaintenance"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Eliminar"
                android:textColor="@color/carcare_danger"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
