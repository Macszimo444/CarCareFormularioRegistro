<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.CarCare.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="top" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardIcon"
                android:layout_width="44dp" android:layout_height="44dp"
                app:cardBackgroundColor="@color/carcare_soft_blue" app:cardCornerRadius="12dp"
                app:cardElevation="0dp" app:strokeWidth="0dp">
                <ImageView android:id="@+id/ivIcon" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" android:importantForAccessibility="no"
                    android:src="@drawable/ic_wrench" app:tint="@color/carcare_electric_blue" />
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/carcare_text_primary" android:textSize="16sp" android:textStyle="bold"
                    tools:text="Cambio de aceite sintético" />
                <TextView android:id="@+id/tvSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/carcare_text_secondary" android:textSize="13sp"
                    tools:text="15/09/2026 • 120,000 km" />
                <TextView android:id="@+id/tvWorkshop" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/carcare_text_muted" android:textSize="12sp"
                    tools:text="Taller López" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvCost" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp" android:textColor="@color/carcare_text_primary"
                android:textSize="15sp" android:textStyle="bold" tools:text="$1,250.00" />
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_maintenance_status" android:paddingHorizontal="10dp"
                android:paddingVertical="6dp" android:textColor="@color/carcare_electric_blue"
                android:textSize="12sp" android:textStyle="bold" tools:text="Próximo" />
            <ImageButton android:id="@+id/btnDelete" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/maintenance_delete" android:padding="12dp"
                android:src="@drawable/ic_close" app:tint="@color/carcare_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
