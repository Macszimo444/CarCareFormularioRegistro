<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carcare_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title & Subtitle Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mantenimiento_titulo"
                    android:textColor="@color/carcare_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMonitoredSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/carcare_text_secondary"
                    android:textSize="13sp"
                    tools:text="3 servicios monitoreados" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewHistory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/ver_historial"
                android:textColor="@color/carcare_electric_blue"
                android:textSize="12sp"
                app:icon="@drawable/ic_historial"
                app:iconTint="@color/carcare_electric_blue"
                app:strokeColor="@color/carcare_electric_blue" />
        </LinearLayout>

        <!-- Filter Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/carcare_field"
            app:tabBackground="@color/carcare_field"
            app:tabIndicatorColor="@color/carcare_electric_blue"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/carcare_electric_blue"
            app:tabTextColor="@color/carcare_text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_todos" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_proximos" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_realizados" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/containerEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Empty"
                android:src="@drawable/ic_mantenimiento"
                app:tint="@color/carcare_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_mantenimiento"
                android:textColor="@color/carcare_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_mantenimiento_btn"
                app:backgroundTint="@color/carcare_electric_blue" />
        </LinearLayout>

        <!-- RecyclerView List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMaintenances"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_maintenance" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMaintenance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Agregar mantenimiento"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/carcare_electric_blue"
        app:tint="@color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
