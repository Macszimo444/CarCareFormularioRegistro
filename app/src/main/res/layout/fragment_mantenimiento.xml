<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusable="true" android:focusableInTouchMode="true"
    android:background="@color/carcare_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/mantenimiento_titulo" android:textColor="@color/carcare_text_primary"
                    android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvMonitoredSubtitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/carcare_text_secondary" android:textSize="13sp"
                    tools:text="6 servicios monitoreados" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnViewHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
                android:minWidth="48dp" android:minHeight="48dp" android:padding="12dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:contentDescription="@string/ver_historial"
                app:icon="@drawable/ic_historial" app:iconPadding="0dp" app:iconGravity="textStart"
                app:iconSize="24dp" app:iconTint="@color/carcare_electric_blue" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSearchMaintenance"
            style="@style/Widget.CarCare.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            app:boxBackgroundColor="@color/carcare_field" app:boxStrokeColor="@color/carcare_input_stroke"
            app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/carcare_text_secondary"
            app:startIconCheckable="false" app:endIconMode="clear_text"
            app:endIconTint="@color/carcare_text_secondary">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSearchMaintenance"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                android:hint="@string/maintenance_search_hint" android:inputType="text"
                android:imeOptions="actionSearch" android:singleLine="true" android:maxLength="200"
                android:textColor="@color/carcare_text_primary" android:textColorHint="@color/carcare_text_secondary"
                android:textSize="15sp" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.tabs.TabLayout android:id="@+id/tabFilters"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="16dp" android:background="@color/carcare_field"
            app:tabBackground="@color/carcare_field" app:tabMode="fixed" app:tabGravity="fill"
            app:tabPaddingStart="4dp" app:tabPaddingEnd="4dp"
            app:tabIndicatorColor="@color/carcare_electric_blue" app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/carcare_electric_blue" app:tabTextColor="@color/carcare_text_secondary">
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/filter_todos" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/filter_proximos" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/filter_realizados" />
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMaintenances"
                android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="16dp"
                android:clipToPadding="false" android:paddingBottom="88dp" tools:listitem="@layout/item_maintenance" />
            <LinearLayout android:id="@+id/containerEmpty" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
                android:paddingBottom="72dp" android:visibility="gone">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_mantenimiento"
                    app:tint="@color/carcare_text_muted" />
                <TextView android:id="@+id/tvEmptyTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center"
                    android:text="@string/maintenance_no_results" android:textColor="@color/carcare_text_primary"
                    android:textSize="16sp" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/tvEmptyMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
                    android:text="@string/maintenance_try_another_term" android:textColor="@color/carcare_text_secondary"
                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEmptyAdd"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:layout_marginTop="16dp" android:text="@string/empty_mantenimiento_btn"
                    app:backgroundTint="@color/carcare_electric_blue" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progressLoading" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:indeterminateTint="@color/carcare_electric_blue" />
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAddMaintenance"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="24dp" android:contentDescription="@string/empty_mantenimiento_btn"
        android:src="@drawable/ic_add" app:backgroundTint="@color/carcare_electric_blue" app:tint="@color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
