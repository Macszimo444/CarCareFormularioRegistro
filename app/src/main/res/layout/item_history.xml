<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="16dp">

    <!-- Vertical Timeline Column -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/ic_check" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/carcare_border" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CarCare.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvServiceTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/carcare_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Cambio de Aceite Sintético" />

                <TextView
                    android:id="@+id/tvCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/carcare_success"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$1,250.00" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDateMileage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/carcare_text_secondary"
                android:textSize="12sp"
                tools:text="2026-08-15 • 80,000 km" />

            <TextView
                android:id="@+id/tvWorkshop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/carcare_text_muted"
                android:textSize="11sp"
                tools:text="Taller Ford San Fernando" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
