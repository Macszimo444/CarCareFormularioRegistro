<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.CarCareFormularioRegistro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/carcare_electric_blue</item>
        <item name="colorPrimaryContainer">@color/carcare_soft_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/carcare_card</item>
        <item name="colorOnSurface">@color/carcare_text_primary</item>
        <item name="colorOutline">@color/carcare_border</item>
        <item name="android:colorAccent">@color/carcare_electric_blue</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/carcare_background</item>
        <item name="android:statusBarColor">@color/carcare_background</item>
        <item name="android:windowBackground">@color/carcare_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CarCareFormularioRegistro" parent="Base.Theme.CarCareFormularioRegistro" />

    <style name="Widget.CarCare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/carcare_card</item>
        <item name="strokeColor">@color/carcare_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.CarCare.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/carcare_field</item>
        <item name="boxStrokeColor">@color/carcare_border</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/carcare_danger</item>
    </style>
</resources>
